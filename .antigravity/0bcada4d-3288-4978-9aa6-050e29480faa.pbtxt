        }
        lines {
          text: "  if (opacity < 0.2) return 1;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const hex = color.replace(\'#\', \'\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const r = parseInt(hex.substring(0, 2), 16);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
