        }
        lines {
          text: "                    textShadow: `${outlineWidth}px ${outlineWidth}px ${outlineWidth}px ${outlineColor}, 0 0 ${glowIntensity * 4}px ${glowIntensity > 0 ? glowColor : \'transparent\'}`,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    opacity: textBrightness(backgroundColor, backgroundOpacity),"
