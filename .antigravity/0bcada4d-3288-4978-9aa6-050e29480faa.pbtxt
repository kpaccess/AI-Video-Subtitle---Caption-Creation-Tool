        lines {
          text: "function textBrightness(color: string, opacity: number): number {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  if (opacity < 0.2) return 1;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const hex = color.replace(\'#\', \'\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
