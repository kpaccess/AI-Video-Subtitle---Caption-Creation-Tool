        lines {
          text: "  // Convert seconds to readable MM:SS"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const formatTimeMinutes = (time: number): string => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
