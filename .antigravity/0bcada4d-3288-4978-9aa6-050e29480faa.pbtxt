        lines {
          text: "    const ms = Math.floor((time % 1) * 10);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    return `${mins}:${String(secs).padStart(2, \'0\')}.${ms}`;"
