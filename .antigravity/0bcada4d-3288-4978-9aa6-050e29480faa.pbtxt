        }
        lines {
          text: "  const b = parseInt(hex.substring(4, 6), 16);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const brightness = (r * 299 + g * 587 + b * 114) / 1000;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  // If light background, return full, else normal"
