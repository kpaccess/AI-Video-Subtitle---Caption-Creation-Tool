    replacement_chunks {
      target_content: "  // Play / Pause toggling\n  const handlePlayPause = () => {\n    const video = videoRef.current;\n    if (!video) return;\n    if (isPlaying) {\n      video.pause();\n    } else {\n      video.play().catch(err => console.error(\"Playback interrupted:\", err));\n    }\n  };\n\n  // Skip / seek video\n  const handleSeek = (newTime: number) => {\n    const video = videoRef.current;\n    if (!video) return;\n    const boundedTime = Math.max(0, Math.min(newTime, duration));\n    video.currentTime = boundedTime;\n    setCurrentTime(boundedTime);\n  };"
      replacement_content: "  // Play / Pause toggling\n  const handlePlayPause = () => {\n    if (virtualVideoMode) {\n      setIsPlaying(prev => !prev);\n    } else {\n      const video = videoRef.current;\n      if (!video) return;\n      if (isPlaying) {\n        video.pause();\n      } else {\n        video.play().catch(err => {\n          console.error(\"Playback interrupted:\", err);\n          // Auto fall back to virtual mode simulation\n          setVirtualVideoMode(true);\n          setIsPlaying(true);\n        });\n      }\n    }\n  };\n\n  // Skip / seek video\n  const handleSeek = (newTime: number) => {\n    const boundedTime = Math.max(0, Math.min(newTime, duration));\n    setCurrentTime(boundedTime);\n    if (!virtualVideoMode && videoRef.current) {\n      try {\n        videoRef.current.currentTime = boundedTime;\n      } catch (err) {\n        console.warn(\"Direct HTML5 video seeking failed:\", err);\n      }\n    }\n  };\n\n  // Virtual Codec Simulation / Playback ticking simulator\n  useEffect(() => {\n    if (!virtualVideoMode || !isPlaying) return;\n\n    let lastTime = performance.now();\n    let frameId: number;\n\n    const tick = () => {\n      const now = performance.now();\n      const delta = (now - lastTime) / 1000; // seconds\n      lastTime = now;\n\n      setCurrentTime(prev => {\n        const next = prev + delta * playbackSpeed;\n        if (next >= duration) {\n          setIsPlaying(false);\n          return 0;\n        }\n        return next;\n      });\n\n      frameId = requestAnimationFrame(tick);\n    };\n\n    frameId = requestAnimationFrame(tick);\n    return () => cancelAnimationFrame(frameId);\n  }, [virtualVideoMode, isPlaying, playbackSpeed, duration]);"
    }
