        lines {
          text: "function hexToRgba(hex: string, alpha: number): string {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const cleanHex = hex.replace(\'#\', \'\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const r = parseInt(cleanHex.substring(0, 2), 16);"
