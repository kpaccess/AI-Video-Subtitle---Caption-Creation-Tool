n              >\n                <FileText className=\"w-3.5 h-3.5 text-green-400\" />\n                TXT Transcript\n              </button>\n              <button\n                id=\"export-project\"\n                onClick={() => handleDownloadFile(\'project\')}\n                className=\"bg-blue-600 hover:bg-blue-500 text-white px-3 py-2 rounded-xl text-xs font-bold flex items-center gap-1.5 transition-all shadow shadow-blue-500/15\"\n              >\n                <FolderSync className=\"w-3.5 h-3.5\" />\n                Save Studio Project\n              </button>\n            </div>\n          </div>\n\n        </div>\n\n        {/* RIGHT COLUMN: Tool Configuration & Manuscript drawers (5 Cols) */}\n        <div className=\"lg:col-span-5 flex flex-col bg-slate-950/40 rounded-2xl border border-slate-900 overflow-hidden\">\n          \n          {/* Drawer tab selections */}\n          <div className=\"grid grid-cols-4 border-b border-slate-900 bg-slate-950/80\">\n            <button\n              id=\"tab-style\"\n              onClick={() => setActiveTab(\'style\')}\n              className={`py-3.5 text-xs font-bold transition-all border-b-2 flex flex-col items-center gap-1 ${activeTab === \'style\' ? \'border-blue-500 text-blue-400 bg-slate-900/60\' : \'border-transparent text-slate-400 hover:text-slate-200\'}`}\n            >\n              <FontIcon className=\"w-4 h-4\" />\n              <span>Aesthetic</span>\n            </button>\n            <button\n              id=\"tab-editor\"\n              onClick={() => setActiveTab(\'editor\')}\n              className={`py-3.5 text-xs font-bold transition-all border-b-2 flex flex-col items-center gap-1 ${activeTab === \'editor\' ? \'border-blue-500 text-blue-400 bg-slate-900/60\' : \'border-transparent text-slate-400 hover:text-slate-200\'}`}\n            >\n              <Sliders className=\"w-4 h-4\" />\n              <span>Edit Timeline</span>\n            </button>\n            <button\n              id=\"tab-ai\"\n              onClick={() => setActiveTab(\'ai\')}\n              className={`py-3.5 text-xs font-bold transition-all border-b-2 flex flex-col items-center gap-1 ${activeTab === \'ai\' ? \'border-blue-500 text-blue-400 bg-slate-900/60\' : \'border-transparent text-slate-400 hover:text-slate-200\'}`}\n            >\n              <Upload className=\"w-4 h-4\" />\n              <span>AI Transcription</span>\n            </button>\n            <button\n              id=\"tab-smart\"\n              onClick={() => setActiveTab(\'smart\')}\n              className={`py-3.5 text-xs font-bold transition-all border-b-2 flex flex-col items-center gap-1 ${activeTab === \'smart\' ? \'border-blue-500 text-blue-400 bg-slate-900/60\' : \'border-transparent text-slate-400 hover:text-slate-200\'}`}\n            >\n              <Sparkles className=\"w-4 h-4\" />\n              <span>Smart AI Tools</span>\n            </button>\n          </div>\n\n          {/* Drawer content frame wrapper */}\n          <div className=\"flex-1 p-5 overflow-y-auto max-h-[640px] mini-scroll\">"
      replacement_content: "          {/* Quick Package Exports Board */}\n          <div className=\"p-4 rounded-2xl bg-gradient-to-br from-[#0c1222]/80 to-[#030712]/90 backdrop-blur-md border border-slate-800/60 flex flex-wrap items-center justify-between gap-4\">\n            <div className=\"flex items-center gap-2\">\n              <div className=\"p-1.5 bg-blue-600/15 text-blue-400 rounded-lg\">\n                <Download className=\"w-4 h-4\" />\n              </div>\n              <div>\n                <h3 className=\"text-xs font-bold text-white\">Publish & Export Center</h3>\n                <p className=\"text-[10px] text-slate-400\">Produce universally-synced caption documents</p>\n              </div>\n            </div>\n\n            <div className=\"flex flex-wrap gap-2\">\n              <button\n                id=\"export-srt\"\n                onClick={() => handleDownloadFile(\'srt\')}\n                className=\"bg-slate-900/80 border border-slate-800 hover:bg-slate-800/80 hover:border-slate-700 text-slate-300 px-3 py-2 rounded-xl text-xs font-semibold flex items-center gap-1.5 transition-all\"\n              >\n                <FileText className=\"w-3.5 h-3.5 text-blue-400\" />\n                SRT Captions\n              </button>\n              <button\n                id=\"export-vtt\"\n                onClick={() => handleDownloadFile(\'vtt\')}\n                className=\"bg-slate-900/80 border border-slate-800 hover:bg-slate-800/80 hover:border-slate-700 text-slate-300 px-3 py-2 rounded-xl text-xs font-semibold flex items-center gap-1.5 transition-all\"\n              >\n                <FileText className=\"w-3.5 h-3.5 text-pink-400\" />\n                VTT Web Player\n              </button>\n              <button\n                id=\"export-txt\"\n                onClick={() => handleDownloadFile(\'txt\')}\n                className=\"bg-slate-900/80 border border-slate-800 hover:bg-slate-800/80 hover:border-slate-700 text-slate-300 px-3 py-2 rounded-xl text-xs font-semibold flex items-center gap-1.5 transition-all\"\n              >\n                <FileText className=\"w-3.5 h-3.5 text-green-400\" />\n                TXT Transcript\n              </button>\n              <button\n                id=\"export-project\"\n                onClick={() => handleDownloadFile(\'project\')}\n                className=\"bg-blue-600 hover:bg-blue-500 text-white px-3 py-2 rounded-xl text-xs font-bold flex items-center gap-1.5 transition-all shadow shadow-blue-500/15\"\n              >\n                <FolderSync className=\"w-3.5 h-3.5\" />\n                Save Studio Project\n              </button>\n            </div>\n          </div>\n\n        </div>\n\n        {/* RIGHT COLUMN: Tool Configuration & Manuscript drawers (5 Cols) */}\n        <div className=\"lg:col-span-5 flex flex-col bg-[#0f172a]/40 backdrop-blur-md rounded-2xl border border-slate-800/80 overflow-hidden shadow-xl\">\n          \n          {/* Drawer tab selections */}\n          <div className=\"grid grid-cols-4 border-b border-slate-800/60 bg-[#0c1322]/80\">\n            <button\n              id=\"tab-style\"\n              onClick={() => setActiveTab(\'style\')}\n              className={`py-3.5 text-xs font-bold transition-all border-b-2 flex flex-col items-center gap-1 ${activeTab === \'style\' ? \'border-blue-500 text-blue-400 bg-[#1e293b]/40\' : \'border-transparent text-slate-400 hover:text-slate-200 hover:bg-slate-900/20\'}`}\n            >\n              <FontIcon className=\"w-4 h-4\" />\n              <span>Aesthetic</span>\n            </button>\n            <button\n              id=\"tab-editor\"\n              onClick={() => setActiveTab(\'editor\')}\n              className={`py-3.5 text-xs font-bold transition-all border-b-2 flex flex-col items-center gap-1 ${activeTab === \'editor\' ? \'border-blue-500 text-blue-400 bg-[#1e293b]/40\' : \'border-transparent text-slate-400 hover:text-slate-200 hover:bg-slate-900/20\'}`}\n            >\n              <Sliders className=\"w-4 h-4\" />\n              <span>Edit Timeline</span>\n            </button>\n            <button\n              id=\"tab-ai\"\n              onClick={() => setActiveTab(\'ai\')}\n              className={`py-3.5 text-xs font-bold transition-all border-b-2 flex flex-col items-center gap-1 ${activeTab === \'ai\' ? \'border-blue-500 text-blue-400 bg-[#1e293b]/40\' : \'border-transparent text-slate-400 hover:text-slate-200 hover:bg-slate-900/20\'}`}\n            >\n              <Upload className=\"w-4 h-4\" />\n              <span>AI Transcription</span>\n            </button>\n            <button\n              id=\"tab-smart\"\n              onClick={() => setActiveTab(\'smart\')}\n              className={`py-3.5 text-xs font-bold transition-all border-b-2 flex flex-col items-center gap-1 ${activeTab === \'smart\' ? \'border-blue-500 text-blue-400 bg-[#1e293b]/40\' : \'border-transparent text-slate-400 hover:text-slate-200 hover:bg-slate-900/20\'}`}\n            >\n              <Sparkles className=\"w-4 h-4\" />\n              <span>Smart AI Tools</span>\n            </button>\n          </div>\n\n          {/* Drawer content frame wrapper */}\n          <div className=\"flex-1 p-5 overflow-y-auto max-h-[640px] mini-scroll\">"
